{
  "ProcessorList": [
    {
      "ClassName": "MyTask.SqlDatabaseProcessor",
      "Path": "C:\\Users\\Steven\\source\\repos\\MySolution\\MyHub\\bin\\Debug\\net8.0\\MyTask.dll",
      "IsEnabled": true
    },
    {
      "ClassName": "MyTask.HttpWebApiProcessor",
      "Path": "C:\\Users\\Steven\\source\\repos\\MySolution\\MyHub\\bin\\Debug\\net8.0\\MyTask.dll",
      "IsEnabled": true
    }
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Server=myServer;Database=myDb;User Id=myUser;Password=myPass;Connect Timeout=3;",
    "LoggerDBConnection": "Server=myServer;Database=LogDB;User Id=LoggerAdmin;Password=myPass;Connect Timeout=3;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    //必須明確加上這一組，否則 EventLog 預設只收 Warning 以上
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "LogFileBaseDir": {
    "BaseDirectory": "D:/LogFiles"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Map", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "EventLog",
        "Args": {
          "source": "MyHubService", // 事件來源名稱（通常用你的應用程式名稱）
          "logName": "MyEventLog", // 寫入的日誌類別（預設是 Application）
          "manageEventSource": true // 讓 Serilog 自動幫你建立事件來源（需要系統管理員權限）
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "SqlDatabaseProcessor": {
    "connectionStr": "Server=10.0.0.5;Database=PMT;User Id=PMT;Password=PMT;",
    "TimeoutSeconds": 10

  }
}

